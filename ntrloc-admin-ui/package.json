{
  "name": "ntrloc-admin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild:coverage": "node -e \"fs.rmSync('target/coverage-data', { recursive: true, force: true }); fs.mkdirSync('target/coverage-data', { recursive: true })\"",
    "build:coverage": "vite build --mode coverage",
    "coverage:report": "nyc report --cwd .. --temp-dir ntrloc-admin-ui/target/coverage-data --report-dir ntrloc-admin-ui/target/coverage --reporter=lcov --reporter=text-summary",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "nyc": "^18.0.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vite-plugin-istanbul": "^9.0.1"
  }
}
