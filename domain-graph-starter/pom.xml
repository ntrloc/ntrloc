<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.ntrloc</groupId>
        <artifactId>ntrloc</artifactId>
        <version>1.0.2-SNAPSHOT</version>
    </parent>

    <artifactId>domain-graph-starter</artifactId>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring.boot.version>4.1.0</spring.boot.version>
        <!-- Pinned to exactly what Spring Boot 4.1.0's own BOM (spring-boot-dependencies) manages
             flyway.version as, since this project has no Boot BOM import to inherit it from. -->
        <flyway.version>12.4.0</flyway.version>
        <jackson.tools.version>3.1.4</jackson.tools.version>
        <scalar.version>3.0.3</scalar.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <selenium.version>4.43.0</selenium.version>
        <opentelemetry.instrumentation.version>2.29.0</opentelemetry.instrumentation.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <hazelcast.version>5.7.0</hazelcast.version>
        <!-- Must match media-processor-api's grpc.version: all io.grpc artifacts share one version -->
        <grpc.version>1.85.1</grpc.version>
        <!-- Set to true (e.g. -Dfrontend.skip=true) to skip the React admin UI build when
             iterating purely on Java; same flag name/purpose as ntrloc-admin-ui's own pom. -->
        <frontend.skip>false</frontend.skip>
    </properties>

    <dependencies>

        <!-- Build-order only: no classes, nothing on the classpath, not passed on to consumers.
             Makes the reactor build ntrloc-admin-ui first, so its clean can't delete the UI test
             coverage this module's build writes into ntrloc-admin-ui/target/ afterwards. -->
        <dependency>
            <groupId>org.ntrloc</groupId>
            <artifactId>ntrloc-admin-ui</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>

        <!-- Spring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring.boot.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-to-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- No dependencyManagement/BOM import exists in this pom; every Spring Boot artifact is
             pinned individually via ${spring.boot.version} above instead. That only controls this
             project's own direct dependencies, not what third-party libraries pull in
             transitively: springdoc-openapi-starter-webmvc-scalar's own dependency chain drags in
             spring-boot-web-server:4.0.5, which Maven's "nearest wins" conflict resolution was
             picking over this project's 4.1.0 (shallower tree depth via that path), causing a
             real, observed NoClassDefFoundError at context startup (TomcatServletWebServerFactory
             introspection failing on a 4.1.0-only inner class against the 4.0.5 jar). Declaring it
             directly here, at depth 1, forces the correct version to win regardless of what any
             transitive dependency asks for. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- UI hosting (org.ntrloc.ui.hosting): configurable multi-mount static-file serving,
             absorbed from the former standalone ui-hosting module: every ntrloc-based app
             extends domain-graph-starter, so there was no separate consumer left to justify
             keeping it out. See docs/ntrloc-ui-hosting-summary.md. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>${spring.boot.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-ldap</artifactId>
            <version>7.1.0</version>
        </dependency>

        <!-- SAML 2.0 sign-in. Its OpenSAML dependency comes from the Shibboleth repository (root pom). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-saml2-service-provider</artifactId>
            <version>7.1.0</version>
        </dependency>
        <!-- Generates each SAML provider's self-signed signing certificate (SamlCertificates). Already
             on the classpath via OpenSAML, at this version; explicit since ntrloc uses it directly. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.84</version>
        </dependency>

        <!-- SpEL evaluation of item-type display-label patterns (RegisterPartitionManager). Both
             were already transitively resolved at this exact version via
             spring-security-ldap to spring-security-core, but made explicit rather than relying
             on that transitive path staying intact; pinned since this project has no Boot BOM
             import to inherit a managed version from (see flyway.version's own comment above). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>7.0.8</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-expression</artifactId>
            <version>7.0.8</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- Boot 4 split Flyway autoconfiguration out of spring-boot-autoconfigure into its own
             module (spring-boot-flyway); spring-boot-starter-flyway pulls that plus flyway-core
             (pinned to 12.4.0 by Boot's own dependency management) transitively. Postgres support
             isn't bundled by Flyway itself past a small set of natively-supported databases, so
             flyway-database-postgresql still needs its own explicit dependency. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.tools.version}</version>
        </dependency>

        <!-- Observability -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-spring-boot-starter</artifactId>
            <version>${opentelemetry.instrumentation.version}</version>
        </dependency>

        <!-- opentelemetry-spring-boot-starter's Boot-4-targeted instrumentation autoconfiguration
             classes (RestClientInstrumentationSpringBoot4AutoConfiguration and friends) are guarded
             by @ConditionalOnClass(RestClientCustomizer.class), referencing Spring Boot 4's own
             split-module package. Without this dependency present, that condition can't be
             evaluated cleanly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- Bridges Log4j2 log events into the OTel logs pipeline via the appender declared in
             log4j2-spring.xml. opentelemetry-spring-boot-starter's OpenTelemetryAppenderAutoConfiguration
             wires it to the initialized OpenTelemetry SDK instance at startup. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-log4j-appender-2.17</artifactId>
            <version>2.29.0-alpha</version>
        </dependency>

        <!-- Both jackson worlds in this build (tools.jackson.core:jackson-databind for Jackson 3.x,
             plus the root pom's legacy com.fasterxml.jackson stack, now on 2.21.8) share this one
             artifact. Since Jackson 2.20, jackson-annotations deliberately dropped its patch
             segment and ships as a bare "2.21" for the whole 2.21.x line (see jackson-bom's
             jackson.version.annotations), so this stays "2.21" even though databind is 2.21.8.
             Pinned directly here so Maven's depth-based mediation can't hand some consumer of this
             module a "nearer" transitive 2.19.x copy instead. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.21</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.12</version>
        </dependency>

        <!-- Workflow (BPMN/DMN/CMMN): walking-skeleton step, embedded with Flowable's own
             default persistence for now. See docs/ntrloc-workflow-summary.md. -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-engine</artifactId>
            <version>8.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring</artifactId>
            <version>8.0.0</version>
        </dependency>

        <!-- DMN engine, for decision-table evaluation from a <serviceTask flowable:type="dmn">
             (NOT businessRuleTask, which is legacy Drools/KIE, unrelated to DMN). Pulls in
             flowable-dmn-engine/-spring/-engine-configurator/-model/-xml-converter transitively. -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-dmn-spring-configurator</artifactId>
            <version>8.0.0</version>
        </dependency>

        <!-- JSR-223 script engines pulled in to back Flowable Script Task execution
             (scriptFormat="javascript" / "groovy"). Neither ships with the JDK or with
             flowable-engine itself. -->
        <dependency>
            <groupId>org.openjdk.nashorn</groupId>
            <artifactId>nashorn-core</artifactId>
            <version>15.7</version>
        </dependency>

        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-jsr223</artifactId>
            <version>5.0.2</version>
        </dependency>

        <!-- Binary storage -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>3.2.3</version>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.5.0-jre</version>
        </dependency>

        <!-- Clustering (org.ntrloc.graph.cluster): lifted from domain-graph-starter, which is no
             longer the owner, per the process-execution clustering design (docs/
             ntrloc-workflow-summary.md Section 6). -->
        <dependency>
            <groupId>com.hazelcast</groupId>
            <artifactId>hazelcast</artifactId>
            <version>${hazelcast.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hazelcast</groupId>
            <artifactId>hazelcast-spring</artifactId>
            <version>${hazelcast.version}</version>
        </dependency>

        <!-- Media processor client (org.ntrloc.graph.mediaprocessor): optional at the deployment
             level only. media-processor-api and grpc-stub/grpc-protobuf/protobuf-java (transitive
             through it) are always on the classpath, same as Hazelcast above for clustering.
             MediaProcessorClientConfiguration only opens a channel and creates client beans when
             media-processor.url is actually configured. grpc-netty-shaded is the one dependency
             this app needs beyond what media-processor-api brings: the client-side Netty
             transport, mirroring ntrloc-media-processor's own server-side choice of the same
             artifact. -->
        <dependency>
            <groupId>org.ntrloc</groupId>
            <artifactId>media-processor-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>

        <!-- Scalar -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-scalar</artifactId>
            <version>${scalar.version}</version>
        </dependency>

        <!-- Streaming multipart parsing for BinaryController.upload (org.ntrloc.graph.db.partition.
             binary): Spring MVC's own multipart resolution (spring.servlet.multipart.enabled=true,
             the default) fully parses request.getParts() before any controller method runs, which
             defeats the whole point here: uploads must never be buffered, not even to a temp
             file, regardless of size. spring.servlet.multipart.enabled is forced to false for
             every application built on this module (BinaryUploadMultipartEnvironmentPostProcessor,
             registered in META-INF/spring.factories; not something each consuming application's
             own application.yml needs to know to set) specifically so BinaryController gets the
             raw, still-unconsumed HttpServletRequest instead, and parses it with this library's
             low-level streaming API (JakartaServletFileUpload.getItemIterator): bytes are read
             directly off the request body as they arrive, the same property Flux<PartEvent> gave
             under WebFlux. Pinned to 2.0.0-M5 deliberately: as of this writing it is the only
             published version of the Jakarta Servlet 6 variant, a milestone rather than a GA
             release, a known accepted tradeoff, not an oversight. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-fileupload2-jakarta-servlet6</artifactId>
            <version>2.0.0-M5</version>
        </dependency>

        <!-- MCP (org.ntrloc.graph.ai): auto-configures an MCP server over Spring MVC and exposes
             any @McpTool-annotated bean method as a tool, no further config needed. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- Test -->
        <!-- Overrides the root pom's junit-jupiter-engine:5.11.4 for this module only —
             Spring Boot 4.1's test starter pulls in JUnit 6 (junit-jupiter:6.0.3) transitively,
             and a split 5.x/6.x classpath fails with NoSuchMethodError on ExtensionContext$Store. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <version>${spring.boot.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot 4 split WebTestClient test-autoconfiguration out of the generic
             spring-boot-test-autoconfigure jar into its own module. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webtestclient</artifactId>
            <version>${spring.boot.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- React admin UI tests (*UiTest, see the ui-tests profile): the browser runs in a container,
             driven over RemoteWebDriver. Selenium itself is "provided" in testcontainers-selenium,
             so it's declared here, pinned to what Spring Boot 4.1.0's BOM manages. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-selenium</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-remote-driver</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-chrome-driver</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <version>3.8.6</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Root pom pins surefire 2.22.1 (2019-era), which can't run JUnit Platform 6
                 tests (NoClassDefFoundError on junit-platform-commons classes). Override for
                 this module only — other modules stay on JUnit 5.11 + the inherited surefire. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!-- Builds the React admin UI (ntrloc-admin-ui, a sibling module, not a Maven
                 dependency of this one; it's packaging=pom with no jar artifact to depend on)
                 as part of THIS module's own build, then copies its output into this module's own
                 packaged resources below; so `mvn -pl domain-graph-starter -am ...` alone (this
                 session's own standing build command) rebuilds the UI too, not just a full
                 root-reactor build. workingDirectory/installDirectory point at ntrloc-admin-ui's
                 own node/ (gitignored there), the same directory its own standalone pom already
                 installs into; building there first (or not at all) is harmless either way, and
                 the two builds share one Node install rather than each getting their own. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>${project.basedir}/../ntrloc-admin-ui</workingDirectory>
                    <installDirectory>${project.basedir}/../ntrloc-admin-ui</installDirectory>
                    <skip>${frontend.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install node and npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v22.14.0</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <!-- No per-consumer parameterization needed here any more; this
                                 build is mount-path-agnostic (see vite.config.js's own comment
                                 and MountBasePathResourceTransformer): the real mount path is
                                 resolved server-side, at serve time, from whatever
                                 runtimes/domain-1/application.yml's graph.ui.mounts entry says,
                                 not baked into the build. The exact same target/dist/ this produces would
                                 work unmodified for ntrloc-dam's own, different mount path too. -->
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copies the just-built target/dist/ into this module's own packaged resources, at the
                 classpath location UiHostingConfiguration's /admin-react mount serves from
                 (runtimes/domain-1's application.yml); so the React UI is genuinely bundled
                 into this jar, same as the existing vanilla-JS admin-ui already is, rather than
                 served from an external file:// path that only exists on this one checkout.
                 copy-resources defaults to the process-resources phase, which already runs after
                 generate-resources (frontend-maven-plugin's own default binding above), so the
                 npm build is guaranteed to have already produced target/dist/ by the time this runs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy react admin ui build output</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${frontend.skip}</skip>
                            <outputDirectory>${project.build.outputDirectory}/static/admin-react</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../ntrloc-admin-ui/target/dist</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Selenium tests for the React admin UI (*UiTest) run with the ordinary unit tests unless
             -DskipUiTests is given. This profile builds an Istanbul-instrumented copy of the UI into
             ntrloc-admin-ui/target/dist-coverage/ (never the target/dist/ bundled into this jar)
             before the tests, then merges the window.__coverage__ dumps they write into
             ntrloc-admin-ui/target/coverage/lcov.info for Sonar. The report runs in the test phase too,
             after surefire, since surefire is declared ahead of frontend-maven-plugin above. -->
        <profile>
            <id>ui-tests</id>
            <activation>
                <property>
                    <name>skipUiTests</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>npm build coverage</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run build:coverage</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm coverage report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run coverage:report</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>skip-ui-tests</id>
            <activation>
                <property>
                    <name>skipUiTests</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/*UiTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>