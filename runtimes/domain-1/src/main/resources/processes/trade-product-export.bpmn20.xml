  <process id="tradeProductExport" name="Trade Product Export (US ONIX 3)" isExecutable="true">
    <documentation>
      Models the STEP postProcessorUSOnix event processor.
      Fires every 5 minutes. Finds Channel Staged Products in the EN US context / Approved
      workspace matching tradeProductExportFilter, then for each product in parallel:
      sets the trade exported flag, manages the TRADE channel flag, stamps the export
      timestamp, and approves the product.

      STEP equivalent: postProcessorUSOnix (Event Processor)
        → tradeProductExportGenerateEvent3 (Business Action)
            1. tradeExportedFlag          — sets tradeProcessCategory = "Trade Exported"
            2. setTRADEChannelFlag        — manages Product_Channel TRADE value
            3. calculateTradeExportTimestamp — stamps export timestamp
            4. node.approve()
    </documentation>
    <startEvent id="start" name="Every 5 Minutes">
      <timerEventDefinition>
        <timeCycle>R/PT5M</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="findTradeProducts" />
    <scriptTask id="findTradeProducts" name="Find Trade Products" scriptFormat="groovy">
      <documentation>
        Queries for Channel Staged Products in the EN US context, Approved workspace,
        that match the trade product export filter. Populates the tradeProducts collection
        for the per-product subprocess.
      </documentation>
      <script>
        // placeholder: query tradeProducts matching tradeProductExportFilter
        println("hi there")
      </script>
    </scriptTask>
    <sequenceFlow id="flow2" sourceRef="findTradeProducts" targetRef="perProduct" />
    <subProcess id="perProduct" name="Per Product">
      <multiInstanceLoopCharacteristics flowable:collection="tradeProducts" flowable:elementVariable="product" />
      <startEvent id="sub_start" />
      <sequenceFlow id="sub_flow1" sourceRef="sub_start" targetRef="setTradeExportedFlag" />
      <scriptTask id="setTradeExportedFlag" name="Set Trade Exported Flag" scriptFormat="groovy">
        <documentation>
          Sets tradeProcessCategory = "Trade Exported" on the product.
          STEP equivalent: tradeExportedFlag business action (1 line of JavaScript).
        </documentation>
        <script>// node.getValue("tradeProcessCategory").setSimpleValue("Trade Exported")</script>
      </scriptTask>
      <sequenceFlow id="sub_flow2" sourceRef="setTradeExportedFlag" targetRef="setTradeChannelFlag" />
      <scriptTask id="setTradeChannelFlag" name="Set TRADE Channel Flag" scriptFormat="groovy">
        <documentation>
          Manages the Product_Channel multi-value attribute on the golden product.
          Adds or removes the "TRADE" value based on tradeBISACStatus.
          STEP equivalent: setTRADEChannelFlag business action (Revision 0.14, 58+ lines).
        </documentation>
        <script>// placeholder: manage TRADE value in goldenProduct.Product_Channel based on tradeBISACStatus</script>
      </scriptTask>
      <sequenceFlow id="sub_flow3" sourceRef="setTradeChannelFlag" targetRef="calculateExportTimestamp" />
      <scriptTask id="calculateExportTimestamp" name="Calculate Export Timestamp" scriptFormat="groovy">
        <documentation>
          Stamps the trade export timestamp on the product.
          STEP equivalent: calculateTradeExportTimestamp business action (Revision 0.4, 54+ lines
          of hand-rolled date formatting logic).
          In Groovy: new Date().format("yyyy-MM-dd'T'HH:mm:ss")
        </documentation>
        <script>// placeholder: node.getValue("tradeExportTimestamp").setSimpleValue(new Date().format("yyyy-MM-dd'T'HH:mm:ss"))</script>
      </scriptTask>
      <sequenceFlow id="sub_flow4" sourceRef="calculateExportTimestamp" targetRef="approveProduct" />
      <scriptTask id="approveProduct" name="Approve Product" scriptFormat="groovy">
        <documentation>
          Approves the product node.
          STEP equivalent: Execute JavaScript — node.approve() (1 line).
        </documentation>
        <script>// node.approve()</script>
      </scriptTask>
      <sequenceFlow id="sub_flow5" sourceRef="approveProduct" targetRef="sub_end" />
      <endEvent id="sub_end" />
    </subProcess>
    <sequenceFlow id="flow3" sourceRef="perProduct" targetRef="end" />
    <endEvent id="end" name="Export Complete" />
  </process>
