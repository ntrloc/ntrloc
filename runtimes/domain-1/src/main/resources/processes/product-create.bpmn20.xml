  <process id="productCreate" name="Product Create" isExecutable="true">
    <startEvent id="start" name="Product Submitted" />
    <sequenceFlow id="flow_start_init" sourceRef="start" targetRef="initializeProduct" />
    <callActivity id="initializeProduct" name="Initialize Product" calledElement="productInitialize" />
    <sequenceFlow id="flow_init_split" sourceRef="initializeProduct" targetRef="editSplit" />
    <parallelGateway id="editSplit" name="Launch Parallel Edit" />
    <sequenceFlow id="flow_split_wip" sourceRef="editSplit" targetRef="wipTask" />
    <userTask id="wipTask" name="WIP / Initiate">
      <documentation>Product is being edited. Task assigned to requestingUser / ownerRequestorgroup.</documentation>
    </userTask>
    <sequenceFlow id="flow_wip_isbnStatus" sourceRef="wipTask" targetRef="isbnStatusDecision" />
    <serviceTask id="isbnStatusDecision" name="Evaluate ISBN Status" flowable:type="dmn">
      <extensionElements>
        <flowable:field name="decisionTableReferenceKey">
          <flowable:string>isbnStatus</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow_isbnStatus_isbnGateway" sourceRef="isbnStatusDecision" targetRef="isbnGateway" />
    <exclusiveGateway id="isbnGateway" name="ISBN Already Final?" />
    <sequenceFlow id="flow_isbn_final_back" name="Yes" sourceRef="isbnGateway" targetRef="wipTask">
      <conditionExpression>${isFinal == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_isbn_notfinal_request" name="No" sourceRef="isbnGateway" targetRef="canRequestDecision">
      <conditionExpression>${isFinal == false}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="canRequestDecision" name="Can Request ISBN?" flowable:type="dmn">
      <extensionElements>
        <flowable:field name="decisionTableReferenceKey">
          <flowable:string>canRequest</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow_canRequest_gateway" sourceRef="canRequestDecision" targetRef="requestGateway" />
    <exclusiveGateway id="requestGateway" name="Can Request?" />
    <sequenceFlow id="flow_request_no" name="No" sourceRef="requestGateway" targetRef="wipTask">
      <conditionExpression>${canRequest == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_request_yes" name="Yes" sourceRef="requestGateway" targetRef="requestIsbn">
      <conditionExpression>${canRequest == true}</conditionExpression>
    </sequenceFlow>
    <callActivity id="requestIsbn" name="Request ISBN" calledElement="productRequestIsbn" />
    <sequenceFlow id="flow_request_approve" sourceRef="requestIsbn" targetRef="approveTask" />
    <userTask id="approveTask" name="Pending ISBN Approval">
      <documentation>Awaiting approver sign-off. Task assigned to finalizeUser if set.</documentation>
    </userTask>
    <sequenceFlow id="flow_approve_canFinalize" sourceRef="approveTask" targetRef="canFinalizeDecision" />
    <serviceTask id="canFinalizeDecision" name="Can Finalize?" flowable:type="dmn">
      <extensionElements>
        <flowable:field name="decisionTableReferenceKey">
          <flowable:string>canFinalize</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow_canFinalize_gateway" sourceRef="canFinalizeDecision" targetRef="finalizeGateway" />
    <exclusiveGateway id="finalizeGateway" name="Can Finalize?" />
    <sequenceFlow id="flow_finalize_no" name="No" sourceRef="finalizeGateway" targetRef="approveTask">
      <conditionExpression>${canFinalize == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_finalize_yes" name="Yes" sourceRef="finalizeGateway" targetRef="finalizeProduct">
      <conditionExpression>${canFinalize == true}</conditionExpression>
    </sequenceFlow>
    <callActivity id="finalizeProduct" name="Finalize Product" calledElement="productFinalize" />
    <sequenceFlow id="flow_finalize_confirm" sourceRef="finalizeProduct" targetRef="confirmTask" />
    <userTask id="confirmTask" name="Recently Finalized">
      <documentation>Finalization confirmed. Product removed from Edit Product workflow on entry.</documentation>
    </userTask>
    <sequenceFlow id="flow_confirm_join" sourceRef="confirmTask" targetRef="editJoin" />
    <sequenceFlow id="flow_split_edit" sourceRef="editSplit" targetRef="editProduct" />
    <subProcess id="editProduct" name="Edit Product">
      <startEvent id="editProduct_start">
        <outgoing>Flow_0ww4y3h</outgoing>
      </startEvent>
      <sequenceFlow id="flow_editProduct_start_task" sourceRef="editProduct_start" targetRef="editProduct_editTask" />
      <userTask id="editProduct_editTask" name="Edit Product">
        <incoming>Flow_0ww4y3h</incoming>
        <outgoing>Flow_1b47s1s</outgoing>
      </userTask>
      <sequenceFlow id="flow_editProduct_task_end" sourceRef="editProduct_editTask" targetRef="editProduct_end" />
      <endEvent id="editProduct_end">
        <incoming>Flow_1b47s1s</incoming>
      </endEvent>
      <sequenceFlow id="Flow_0ww4y3h" sourceRef="editProduct_start" targetRef="editProduct_editTask" />
      <sequenceFlow id="Flow_1b47s1s" sourceRef="editProduct_editTask" targetRef="editProduct_end" />
    </subProcess>
    <sequenceFlow id="flow_edit_join" sourceRef="editProduct" targetRef="editJoin" />
    <parallelGateway id="editJoin" name="Edit Track Complete" />
    <sequenceFlow id="flow_join_end" sourceRef="editJoin" targetRef="end" />
    <endEvent id="end" name="Product Create Complete" />
  </process>
