<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="org.ntrloc.workflow"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/BPMN20.xsd">

  <process id="productInitialize" name="Product Initialize" isExecutable="true">
    <documentation>
      Initialization sequence executed on entry to the Product Create workflow.
      Corresponds to STEP business rule: wfa_pCreateISBN_Initiate_OnEntry.
    </documentation>

    <startEvent id="start" name="Start Initialization"/>
    <sequenceFlow id="flow1"  sourceRef="start"              targetRef="logProductEntry"/>
    <scriptTask  id="logProductEntry"       name="Log Product Entry" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow2"  sourceRef="logProductEntry"    targetRef="setOriginalOwner"/>
    <scriptTask  id="setOriginalOwner"      name="Set Original Owner" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow3"  sourceRef="setOriginalOwner"   targetRef="htmlCleanup"/>
    <scriptTask  id="htmlCleanup"           name="HTML Cleanup" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow4"  sourceRef="htmlCleanup"        targetRef="populateFromMonarch"/>
    <scriptTask  id="populateFromMonarch"   name="Populate From Monarch" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow5"  sourceRef="populateFromMonarch"  targetRef="setLanguageAttributes"/>
    <scriptTask  id="setLanguageAttributes" name="Set Language Attributes" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow6"  sourceRef="setLanguageAttributes" targetRef="copyPlaceholderAttrs"/>
    <scriptTask  id="copyPlaceholderAttrs"  name="Copy Placeholder Attributes" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow7"  sourceRef="copyPlaceholderAttrs"  targetRef="reassignWipTask"/>
    <scriptTask  id="reassignWipTask"       name="Reassign WIP Task to Requesting User" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow8"  sourceRef="reassignWipTask"    targetRef="launchEditProductWf"/>
    <scriptTask  id="launchEditProductWf"   name="Launch Edit Product Workflow" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow9"  sourceRef="launchEditProductWf"  targetRef="setMillenniumAttributes"/>
    <scriptTask  id="setMillenniumAttributes" name="Set Millennium Attributes" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow10" sourceRef="setMillenniumAttributes" targetRef="createPpcBomProduct"/>
    <scriptTask  id="createPpcBomProduct"   name="Create PPC BOM Product" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow11" sourceRef="createPpcBomProduct"  targetRef="cloneBom"/>
    <scriptTask  id="cloneBom"              name="Clone BOM" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow12" sourceRef="cloneBom"           targetRef="setMdmDefaultValues"/>
    <scriptTask  id="setMdmDefaultValues"   name="Set Product MDM Default Values" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow13" sourceRef="setMdmDefaultValues"  targetRef="createPermClass"/>
    <scriptTask  id="createPermClass"       name="Create Permission Classification" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow14" sourceRef="createPermClass"    targetRef="saveProduct"/>
    <scriptTask  id="saveProduct"           name="Save Product" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow15" sourceRef="saveProduct"        targetRef="end"/>
    <endEvent     id="end"                   name="Initialization Complete"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_productInitialize">
    <bpmndi:BPMNPlane id="BPMNPlane_productInitialize" bpmnElement="productInitialize">

      <!-- All elements on a single horizontal track, y centre = 80 -->
      <!-- step = 130 (100 wide + 30 gap); events 36x36 at y=62 -->

      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="62" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_logProductEntry" bpmnElement="logProductEntry">
        <dc:Bounds x="166" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_setOriginalOwner" bpmnElement="setOriginalOwner">
        <dc:Bounds x="296" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_htmlCleanup" bpmnElement="htmlCleanup">
        <dc:Bounds x="426" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_populateFromMonarch" bpmnElement="populateFromMonarch">
        <dc:Bounds x="556" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_setLanguageAttributes" bpmnElement="setLanguageAttributes">
        <dc:Bounds x="686" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_copyPlaceholderAttrs" bpmnElement="copyPlaceholderAttrs">
        <dc:Bounds x="816" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_reassignWipTask" bpmnElement="reassignWipTask">
        <dc:Bounds x="946" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_launchEditProductWf" bpmnElement="launchEditProductWf">
        <dc:Bounds x="1076" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_setMillenniumAttributes" bpmnElement="setMillenniumAttributes">
        <dc:Bounds x="1206" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_createPpcBomProduct" bpmnElement="createPpcBomProduct">
        <dc:Bounds x="1336" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_cloneBom" bpmnElement="cloneBom">
        <dc:Bounds x="1466" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_setMdmDefaultValues" bpmnElement="setMdmDefaultValues">
        <dc:Bounds x="1596" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_createPermClass" bpmnElement="createPermClass">
        <dc:Bounds x="1726" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_saveProduct" bpmnElement="saveProduct">
        <dc:Bounds x="1856" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="1986" y="62" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Sequence flow edges (all horizontal at y=80) -->
      <bpmndi:BPMNEdge id="edge_flow1"  bpmnElement="flow1">  <di:waypoint x="136" y="80"/> <di:waypoint x="166" y="80"/>  </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow2"  bpmnElement="flow2">  <di:waypoint x="266" y="80"/> <di:waypoint x="296" y="80"/>  </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow3"  bpmnElement="flow3">  <di:waypoint x="396" y="80"/> <di:waypoint x="426" y="80"/>  </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow4"  bpmnElement="flow4">  <di:waypoint x="526" y="80"/> <di:waypoint x="556" y="80"/>  </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow5"  bpmnElement="flow5">  <di:waypoint x="656" y="80"/> <di:waypoint x="686" y="80"/>  </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow6"  bpmnElement="flow6">  <di:waypoint x="786" y="80"/> <di:waypoint x="816" y="80"/>  </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow7"  bpmnElement="flow7">  <di:waypoint x="916" y="80"/> <di:waypoint x="946" y="80"/>  </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow8"  bpmnElement="flow8">  <di:waypoint x="1046" y="80"/> <di:waypoint x="1076" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow9"  bpmnElement="flow9">  <di:waypoint x="1176" y="80"/> <di:waypoint x="1206" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow10" bpmnElement="flow10"> <di:waypoint x="1306" y="80"/> <di:waypoint x="1336" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow11" bpmnElement="flow11"> <di:waypoint x="1436" y="80"/> <di:waypoint x="1466" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow12" bpmnElement="flow12"> <di:waypoint x="1566" y="80"/> <di:waypoint x="1596" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow13" bpmnElement="flow13"> <di:waypoint x="1696" y="80"/> <di:waypoint x="1726" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow14" bpmnElement="flow14"> <di:waypoint x="1826" y="80"/> <di:waypoint x="1856" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow15" bpmnElement="flow15"> <di:waypoint x="1956" y="80"/> <di:waypoint x="1986" y="80"/> </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
