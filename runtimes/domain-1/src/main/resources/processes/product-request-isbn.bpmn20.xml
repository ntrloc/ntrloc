<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="org.ntrloc.workflow"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/BPMN20.xsd">

  <process id="productRequestIsbn" name="Product Request ISBN" isExecutable="true">
    <documentation>
      Action sequence fired when the user submits the "Request ISBN" event from WIP.
      Corresponds to STEP business rule: wfa_pCreateISBN_Event_OnRequestISBN.
    </documentation>

    <startEvent id="start" name="ISBN Requested"/>
    <sequenceFlow id="flow1" sourceRef="start"               targetRef="saveFinalizationInfo"/>
    <scriptTask  id="saveFinalizationInfo" name="Save Product Finalization Info" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow2" sourceRef="saveFinalizationInfo" targetRef="setStatusRequested"/>
    <scriptTask  id="setStatusRequested"   name="Set Product Status to Requested" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow3" sourceRef="setStatusRequested"  targetRef="partialApprove"/>
    <scriptTask  id="partialApprove"       name="Partial Approve ISBN Finalization" scriptFormat="groovy"><script>// placeholder</script></scriptTask>
    <sequenceFlow id="flow4" sourceRef="partialApprove"      targetRef="end"/>
    <endEvent     id="end"                  name="ISBN Request Complete"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_productRequestIsbn">
    <bpmndi:BPMNPlane id="BPMNPlane_productRequestIsbn" bpmnElement="productRequestIsbn">

      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="62" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_saveFinalizationInfo" bpmnElement="saveFinalizationInfo">
        <dc:Bounds x="166" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_setStatusRequested" bpmnElement="setStatusRequested">
        <dc:Bounds x="296" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_partialApprove" bpmnElement="partialApprove">
        <dc:Bounds x="426" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="556" y="62" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_flow1" bpmnElement="flow1"> <di:waypoint x="136" y="80"/> <di:waypoint x="166" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow2" bpmnElement="flow2"> <di:waypoint x="266" y="80"/> <di:waypoint x="296" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow3" bpmnElement="flow3"> <di:waypoint x="396" y="80"/> <di:waypoint x="426" y="80"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow4" bpmnElement="flow4"> <di:waypoint x="526" y="80"/> <di:waypoint x="556" y="80"/> </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
